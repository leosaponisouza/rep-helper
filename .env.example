# PostgreSQL 16
POSTGRES_DB=rephelper
POSTGRES_USER=rephelper
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# Spring Boot Backend
BACKEND_PORT=8080
# Minimum 32-character secret for HS256 JWT signing
JWT_SECRET=change_me_to_a_random_64_char_secret_key_for_production_usage_only
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Public HTTPS base URL of the API (used to construct media URLs)
APP_PUBLIC_BASE_URL=https://api.seu-dominio.com.br
APP_CORS_ALLOWED_ORIGINS=https://app.seu-dominio.com.br,http://localhost:8081,http://localhost:19006

# Optional Google OAuth Client IDs (comma-separated: android,ios,web)
GOOGLE_CLIENT_IDS=

# Optional Transactional Email HTTP API (e.g., Resend)
# Leave blank in local dev to log 6-digit password reset codes in backend stdout
EMAIL_PROVIDER_URL=https://api.resend.com/emails
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=RepHelper <no-reply@seu-dominio.com.br>
